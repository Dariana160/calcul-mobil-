<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Catalog de haine"
            android:textColor="#49343F"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Alege piesele preferate pentru stilul tău."
            android:textColor="#806D76"
            android:textSize="15sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toate" />

                <Button
                    android:id="@+id/btnTops"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bluze" />

                <Button
                    android:id="@+id/btnPants"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pantaloni" />

                <Button
                    android:id="@+id/btnDresses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rochii" />

                <Button
                    android:id="@+id/btnShoes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Încălțăminte" />

                <Button
                    android:id="@+id/btnAccessories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accesorii" />

            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/catalogContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
